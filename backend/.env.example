# Copy this to .env and fill in real values. Never commit .env.

# === Required ===
ANTHROPIC_API_KEY=sk-ant-

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./haggler.db

# === Apify (Craigslist + Facebook scouts) ===
APIFY_API_KEY=

# === eBay (optional for hackathon — Craigslist works without these) ===
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_SANDBOX=true

# === Email relay for Craigslist ===
# Use a throwaway Gmail with 2FA + app password, not your personal account
GMAIL_USER=
GMAIL_APP_PASSWORD=

# === Tuning ===
LOG_LEVEL=INFO
MAX_CONCURRENT_NEGOTIATIONS=8
NEGOTIATION_TIMEOUT_HOURS=24
GOOD_ENOUGH_DISCOUNT=0.30
